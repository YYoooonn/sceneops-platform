# SceneOps local development configuration.
#
# Precedence (highest wins):
#   1. shell environment (e.g. `POSTGRES_PORT=5433 make local-up`)
#   2. .env.local            — gitignored, your actual local overrides;
#                              `cp .env.example .env.local` to start
#   3. this file's defaults, as loaded by Docker Compose (--env-file,
#      see `ENV_FILE`/`$(COMPOSE)` in the root Makefile) and by
#      apps/api/app/config.py + apps/worker/sceneops_worker/config.py
#      (pydantic env_file=[".env.local", ".env"] — .env.local wins)
#   4. hardcoded field defaults in the application settings classes
#      themselves (used only if no env var is set anywhere)
#
# Do not put real secrets here — this file is committed. The values below
# are harmless local-only defaults (minioadmin/sceneops/etc.), safe to
# commit and safe to run as-is.

# --------------------
# Postgres
# --------------------
POSTGRES_USER=sceneops
POSTGRES_PASSWORD=sceneops
POSTGRES_DB=sceneops
POSTGRES_PORT=5432

# Used by migrations / shared DB config inside Docker
SCENEOPS_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

# For host-side tools, use:
# SCENEOPS_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@localhost:5432/sceneops

# --------------------
# Redis / Celery
# --------------------
REDIS_PORT=6379

# Optional worker concurrency overrides.
SCENEOPS_WORKER_PIPELINE_CONCURRENCY=1
SCENEOPS_WORKER_JOBS_CONCURRENCY=4

# --------------------
# MinIO
# --------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --------------------
# KAFKA
# --------------------
KAFKA_HOST_PORT=9092

# --------------------
# API
# --------------------
API_PORT=8000

SCENEOPS_API_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

SCENEOPS_API_ARTIFACT__BACKEND=minio
SCENEOPS_API_ARTIFACT__ROOT_URI=s3://sceneops/artifacts
SCENEOPS_API_ARTIFACT__ENDPOINT_URL=http://minio:9000
SCENEOPS_API_ARTIFACT__REGION=ap-northeast-2
SCENEOPS_API_ARTIFACT__ACCESS_KEY_ID=minioadmin
SCENEOPS_API_ARTIFACT__SECRET_ACCESS_KEY=minioadmin

# Pipelines are orchestrated by the SceneOps worker (pipeline queue); every Job,
# a pipeline task's included, runs on the job queue.
SCENEOPS_API_EXECUTION__PIPELINE_BACKEND=celery
SCENEOPS_API_EXECUTION__JOB_BACKEND=celery
SCENEOPS_API_EXECUTION__CELERY__BROKER_URL=redis://redis:6379/0
SCENEOPS_API_EXECUTION__CELERY__RESULT_BACKEND=redis://redis:6379/1
SCENEOPS_API_EXECUTION__CELERY__PIPELINE_QUEUE=sceneops.pipeline_runs
SCENEOPS_API_EXECUTION__CELERY__JOB_QUEUE=sceneops.jobs

# --------------------
# Worker
# --------------------
SCENEOPS_WORKER_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

SCENEOPS_WORKER_ARTIFACT__BACKEND=minio
SCENEOPS_WORKER_ARTIFACT__ROOT_URI=s3://sceneops/artifacts
SCENEOPS_WORKER_ARTIFACT__ENDPOINT_URL=http://minio:9000
SCENEOPS_WORKER_ARTIFACT__REGION=ap-northeast-2
SCENEOPS_WORKER_ARTIFACT__ACCESS_KEY_ID=minioadmin
SCENEOPS_WORKER_ARTIFACT__SECRET_ACCESS_KEY=minioadmin

# Read-only external input (e.g. label documents): the root relative input URIs resolve against.
# Local filesystem (default):
SCENEOPS_WORKER_INPUT_SOURCE__BACKEND=local
SCENEOPS_WORKER_INPUT_SOURCE__ROOT_URI=/data/inputs
# MinIO/S3 example:
# SCENEOPS_WORKER_INPUT_SOURCE__BACKEND=minio
# SCENEOPS_WORKER_INPUT_SOURCE__ROOT_URI=s3://sceneops/inputs
# SCENEOPS_WORKER_INPUT_SOURCE__ENDPOINT_URL=http://minio:9000
# SCENEOPS_WORKER_INPUT_SOURCE__REGION=ap-northeast-2
# SCENEOPS_WORKER_INPUT_SOURCE__ACCESS_KEY_ID=minioadmin
# SCENEOPS_WORKER_INPUT_SOURCE__SECRET_ACCESS_KEY=minioadmin


SCENEOPS_WORKER_RUNTIME__WORKER_ID=local-worker

SCENEOPS_WORKER_EXECUTION__PIPELINE_BACKEND=celery
SCENEOPS_WORKER_EXECUTION__JOB_BACKEND=celery
SCENEOPS_WORKER_EXECUTION__CELERY__BROKER_URL=redis://redis:6379/0
SCENEOPS_WORKER_EXECUTION__CELERY__RESULT_BACKEND=redis://redis:6379/1
SCENEOPS_WORKER_EXECUTION__CELERY__PIPELINE_QUEUE=sceneops.pipeline_runs
SCENEOPS_WORKER_EXECUTION__CELERY__JOB_QUEUE=sceneops.jobs

# --------------------
# Inference Server
# --------------------
INFERENCE_PORT=8001

SCENEOPS_INFERENCE_MODEL_ID=IDEA-Research/grounding-dino-tiny
SCENEOPS_INFERENCE_DETECTION_PROMPT=car . person . barrier .
SCENEOPS_INFERENCE_BOX_THRESHOLD=0.35
SCENEOPS_INFERENCE_TEXT_THRESHOLD=0.25
SCENEOPS_INFERENCE_MAX_IMAGE_SIZE=800

# Docker compose sets:
# HF_HOME=/cache/hf
# SCENEOPS_INFERENCE_HF_CACHE_DIR=/cache/hf
#
# For host-side execution outside Docker, optionally set:
# HF_HOME=./cache/hf
# SCENEOPS_INFERENCE_HF_CACHE_DIR=./cache/hf

# --------------------
# Integration runtimes
# --------------------
# ArtifactStore settings an isolated interoperability runtime (the LeRobot
# EXPORT container) reads from its own environment.
SCENEOPS_INTEGRATION_ARTIFACT__BACKEND=minio
SCENEOPS_INTEGRATION_ARTIFACT__ROOT_URI=s3://sceneops/artifacts
SCENEOPS_INTEGRATION_ARTIFACT__ENDPOINT_URL=http://minio:9000
SCENEOPS_INTEGRATION_ARTIFACT__REGION=ap-northeast-2
SCENEOPS_INTEGRATION_ARTIFACT__ACCESS_KEY_ID=minioadmin
SCENEOPS_INTEGRATION_ARTIFACT__SECRET_ACCESS_KEY=minioadmin

# --------------------
# Streaming / Kafka (opt-in, `make streaming-up`)
# --------------------
# Non-canonical transport only -- see docs/architecture/streaming-transport.md.
# Not part of `make local-up`'s default stack.
#
# Two distinct configuration domains, deliberately not mixed:
#
#   1. Local-development / Compose infrastructure (below): KAFKA_HOST_PORT is the
#      HOST-mapped port for Kafka's PLAINTEXT_HOST listener
#      (compose/streaming.yaml). Containers on the sceneops network always
#      reach the broker at kafka:9092 regardless of this value -- only
#      host-side tooling (make smoke-streaming, run via `uv run` on the
#      host) needs it. The broker's own KRaft/listener/controller
#      configuration (KAFKA_NODE_ID, KAFKA_PROCESS_ROLES, ...) lives
#      entirely inside compose/streaming.yaml and is intentionally NOT
#      duplicated here -- it's an infrastructure implementation detail,
#      not something a SceneOps application ever reads.
#
#   2. SceneOps streaming-CLIENT configuration (sceneops_streaming.config.
#      StreamingSettings) -- how SceneOps applications/tools reach Kafka.
#      bootstrap_servers defaults to kafka:9092 (in-network); host-side
#      tools (make smoke-streaming) override it to localhost:${KAFKA_HOST_PORT}
#      via env, instead of changing this default.

SCENEOPS_STREAMING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCENEOPS_STREAMING_KAFKA_TELEMETRY_TOPIC=sceneops.robot.telemetry.v1
SCENEOPS_STREAMING_KAFKA_PRODUCER_CLIENT_ID=sceneops-telemetry-producer
SCENEOPS_STREAMING_KAFKA_CONSUMER_GROUP_ID=sceneops-telemetry-consumer
