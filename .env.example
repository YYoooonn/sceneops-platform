# --------------------
# Dataset defaults
# --------------------
DATASET_ID=nuscenes
DATASET_VERSION=v1.0-mini

# --------------------
# Postgres
# --------------------
POSTGRES_USER=sceneops
POSTGRES_PASSWORD=sceneops
POSTGRES_DB=sceneops

# Used by migrations / shared DB config inside Docker
SCENEOPS_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

# For host-side tools, use:
# SCENEOPS_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@localhost:5432/sceneops

# --------------------
# Redis / Celery
# --------------------
SCENEOPS_CELERY_BROKER_URL=redis://redis:6379/0
SCENEOPS_CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional worker concurrency overrides.
SCENEOPS_WORKER_PIPELINE_CONCURRENCY=1
SCENEOPS_WORKER_JOBS_CONCURRENCY=4

# --------------------
# MinIO
# --------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --------------------
# API
# --------------------
SCENEOPS_API_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

SCENEOPS_API_ARTIFACT__BACKEND=minio
SCENEOPS_API_ARTIFACT__ROOT_URI=s3://sceneops/artifacts
SCENEOPS_API_ARTIFACT__ENDPOINT_URL=http://minio:9000
SCENEOPS_API_ARTIFACT__REGION=ap-northeast-2
SCENEOPS_API_ARTIFACT__ACCESS_KEY_ID=minioadmin
SCENEOPS_API_ARTIFACT__SECRET_ACCESS_KEY=minioadmin

SCENEOPS_API_DEFAULT_DATASET__DATASET_ID=nuscenes
SCENEOPS_API_DEFAULT_DATASET__DATASET_VERSION=v1.0-mini

# SCENEOPS_API_EXECUTION__BACKEND=celery
SCENEOPS_API_EXECUTION__PIPELINE_BACKEND=celery
SCENEOPS_API_EXECUTION__JOB_BACKEND=celery
SCENEOPS_API_EXECUTION__CELERY__BROKER_URL=redis://redis:6379/0
SCENEOPS_API_EXECUTION__CELERY__RESULT_BACKEND=redis://redis:6379/1
SCENEOPS_API_EXECUTION__CELERY__PIPELINE_QUEUE=sceneops.pipeline_runs
SCENEOPS_API_EXECUTION__CELERY__JOB_QUEUE=sceneops.jobs

# Optional Airflow dispatcher config.
# Enable by setting SCENEOPS_API_EXECUTION__BACKEND=airflow.
# USERNAME/PASSWORD must match AIRFLOW_ADMIN_USERNAME/PASSWORD in
# .env.airflow.local — that's the account airflow-init actually creates.
SCENEOPS_API_EXECUTION__AIRFLOW__BASE_URL=http://airflow-webserver:8080
SCENEOPS_API_EXECUTION__AIRFLOW__USERNAME=airflow
SCENEOPS_API_EXECUTION__AIRFLOW__PASSWORD=airflow
SCENEOPS_API_EXECUTION__AIRFLOW__PIPELINE_DAG_ID=sceneops_pipeline_run
SCENEOPS_API_EXECUTION__AIRFLOW__JOB_DAG_ID=sceneops_job_run

# --------------------
# Worker
# --------------------
SCENEOPS_WORKER_DATABASE_URL=postgresql+asyncpg://sceneops:sceneops@postgres:5432/sceneops

SCENEOPS_WORKER_ARTIFACT__BACKEND=minio
SCENEOPS_WORKER_ARTIFACT__ROOT_URI=s3://sceneops/artifacts
SCENEOPS_WORKER_ARTIFACT__ENDPOINT_URL=http://minio:9000
SCENEOPS_WORKER_ARTIFACT__REGION=ap-northeast-2
SCENEOPS_WORKER_ARTIFACT__ACCESS_KEY_ID=minioadmin
SCENEOPS_WORKER_ARTIFACT__SECRET_ACCESS_KEY=minioadmin

# Raw dataset source (read-only).
# Local filesystem (default):
SCENEOPS_WORKER_RAW_SOURCE__BACKEND=local
SCENEOPS_WORKER_RAW_SOURCE__ROOT_URI=/data/raw/nuscenes
# MinIO/S3 example:
# SCENEOPS_WORKER_RAW_SOURCE__BACKEND=minio
# SCENEOPS_WORKER_RAW_SOURCE__ROOT_URI=s3://sceneops/raw/nuscenes
# SCENEOPS_WORKER_RAW_SOURCE__ENDPOINT_URL=http://minio:9000
# SCENEOPS_WORKER_RAW_SOURCE__REGION=ap-northeast-2
# SCENEOPS_WORKER_RAW_SOURCE__ACCESS_KEY_ID=minioadmin
# SCENEOPS_WORKER_RAW_SOURCE__SECRET_ACCESS_KEY=minioadmin

SCENEOPS_WORKER_DEFAULT_DATASET__DATASET_ID=nuscenes
SCENEOPS_WORKER_DEFAULT_DATASET__DATASET_VERSION=v1.0-mini

SCENEOPS_WORKER_RUNTIME__WORKER_ID=local-worker

SCENEOPS_WORKER_EXECUTION__BACKEND=celery
SCENEOPS_WORKER_EXECUTION__CELERY__BROKER_URL=redis://redis:6379/0
SCENEOPS_WORKER_EXECUTION__CELERY__RESULT_BACKEND=redis://redis:6379/1
SCENEOPS_WORKER_EXECUTION__CELERY__PIPELINE_QUEUE=sceneops.pipeline_runs
SCENEOPS_WORKER_EXECUTION__CELERY__JOB_QUEUE=sceneops.jobs

# --------------------
# Inference Server
# --------------------
SCENEOPS_INFERENCE_MODEL_ID=IDEA-Research/grounding-dino-tiny
SCENEOPS_INFERENCE_DETECTION_PROMPT=car . person . barrier .
SCENEOPS_INFERENCE_BOX_THRESHOLD=0.35
SCENEOPS_INFERENCE_TEXT_THRESHOLD=0.25
SCENEOPS_INFERENCE_MAX_IMAGE_SIZE=800

# Docker compose sets:
# HF_HOME=/cache/hf
# SCENEOPS_INFERENCE_HF_CACHE_DIR=/cache/hf
#
# For host-side execution outside Docker, optionally set:
# HF_HOME=./cache/hf
# SCENEOPS_INFERENCE_HF_CACHE_DIR=./cache/hf
